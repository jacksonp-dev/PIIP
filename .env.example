# Copy to .env and fill in. NEVER commit .env or put keys in code/config.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: interpretation model (default = cheapest capable model).
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Safety switch: LLM layer is DRY-RUN (free) unless this is 1 OR you pass --live-llm.
# PIIP_LIVE_LLM=1

# Catalyst Terminal (0DTE Intelligence tab) — free tier, sign up at finnhub.io/register.
# Without this set, the Catalyst Terminal section shows a setup hint instead of headlines.
# FINNHUB_API_KEY=your-finnhub-key-here

# Sent as the contact info in the User-Agent header for Wikipedia (S&P 500 list) and SEC EDGAR
# requests — both sites' own fair-access policies ask for a real way to reach whoever is actually
# running the automated traffic. Put YOUR OWN email here, not anyone else's.
# RESEARCH_CONTACT_EMAIL=you@example.com